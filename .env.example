# Server-side Gemini API key. Keep this secret; set it in the hosting provider.
GEMINI_API_KEY=""

# Public Firebase Web App configuration for the intended QuickFix Firebase project.
# Firebase web API keys are client identifiers, not service-account credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID="(default)"

# Optional Google Maps Platform browser key; restrict it by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=""
